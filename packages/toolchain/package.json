{
  "name": "@paperback/toolchain",
  "description": "Toolchain to build Paperback extensions",
  "keywords": [
    "paperback",
    "toolchain"
  ],
  "author": "Faizan Durrani",
  "homepage": "https://paperback.moe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paperback-iOS/paperback-toolchain.git"
  },
  "bugs": "https://github.com/Paperback-iOS/paperback-toolchain/issues",
  "license": "MIT",
  "version": "1.0.0-alpha.92",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "paperback-cli": "./dist/cli.mjs",
    "__paperback-cli_bash_complete": "./dist/bash-complete.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "protoc:prepare": "shx rm -rf ./src/.generated/ && shx mkdir -p ./src/.generated",
    "protoc:compile": "protoc --ts_out ./src/.generated --ts_opt client_grpc1,ts_nocheck --proto_path src src/toolchain/logcat/protobuf/*.proto",
    "protoc": "npm run protoc:prepare && npm run protoc:compile",
    "prebuild": "npm run protoc && tsc -p tsconfig.json",
    "build": "tsdown --silent",
    "prepublishOnly": "npm run build"
  },
  "tsdown": {
    "deps": {
      "skipNodeModulesBundle": true
    },
    "copy": [
      {
        "from": "src/**/*.template.*",
        "to": "dist/src/",
        "flatten": false
      }
    ],
    "entry": [
      "src/bin/cli.ts"
    ],
    "exports": {
      "bin": false
    },
    "format": [
      "esm"
    ],
    "tsconfig": "tsconfig.json",
    "clean": true,
    "unbundle": true,
    "minify": false
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@paperback/runtime-polyfills": "1.0.0-alpha.92",
    "@paperback/types": "1.0.0-alpha.92",
    "@protobuf-ts/plugin": "^2.11.1",
    "@stricli/auto-complete": "^1.2.6",
    "@stricli/core": "^1.2.6",
    "buffer": "^6.0.3",
    "chai": "^6.2.2",
    "listr2": "^10.2.1",
    "picocolors": "^1.1.1",
    "rolldown": "^1.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/node": "24.x",
    "protoc": "^33.6.0",
    "tsdown": "^0.22.0"
  },
  "exports": {
    ".": "./dist/cli.mjs",
    "./package.json": "./package.json"
  }
}
