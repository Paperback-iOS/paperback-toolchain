{
  "name": "@paperback/toolchain",
  "description": "Toolchain to build Paperback extensions",
  "keywords": [
    "paperback",
    "toolchain",
    "oclif"
  ],
  "author": "Faizan Durrani",
  "homepage": "https://paperback.moe",
  "repository": "https://github.com/Paperback-iOS/paperback-toolchain",
  "bugs": "https://github.com/Paperback-iOS/paperback-toolchain/issues",
  "license": "MIT",
  "version": "1.0.0-alpha.59",
  "scripts": {
    "build": "shx rm -rf lib && tsc -b && cp -r src/homepage lib/ && cp -r src/shims lib/",
    "postpack": "shx rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "version": "oclif readme && git add README.md"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@oclif/core": "^4.8.0",
    "@oclif/plugin-help": "^6.2.36",
    "@oclif/plugin-plugins": "^5.4.54",
    "@paperback/runtime-polyfills": "*",
    "@paperback/types": "*",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "buffer": "^6.0.3",
    "esbuild": "^0.27.1",
    "fs-extra": "^11.3.2",
    "listr2": "^9.0.5",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "^2.11.1",
    "@protobuf-ts/protoc": "^2.11.1",
    "@types/chai": "^5.2.3",
    "@types/fs-extra": "^11.0.4",
    "@types/listr": "^0.14.10",
    "@types/node": "^24.1.0",
    "chai": "^6.2.1",
    "grpc-tools": "^1.13.1",
    "oclif": "^4.22.55",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "paperback-cli": "./bin/run.js"
  },
  "files": [
    "/bin",
    "/lib",
    "/oclif.manifest.json"
  ],
  "oclif": {
    "bin": "paperback-cli",
    "dirname": "paperback-cli",
    "commands": "./lib/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " "
  },
  "ts-node": {
    "esm": true
  },
  "gitHead": "a298e668410f89b19e9a5f2c26840d94e60664b9"
}
