{
  "name": "paperback-monorepo",
  "description": "Monorepo for the Paperback toolchain, types and runtime polyfills",
  "private": true,
  "scripts": {
    "changesets": "npx @changesets/cli",
    "changesets:version": "npx @changesets/cli version",
    "format": "npx eslint . --fix && npx prettier --write ."
  },
  "workspaces": [
    "packages/types",
    "packages/runtime-polyfills",
    "packages/toolchain"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "shx": "^0.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "version": "",
  "allowScripts": {
    "protobufjs@7.6.6": true
  }
}
